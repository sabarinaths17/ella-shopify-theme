{{ 'component-product.css' | asset_url | stylesheet_tag }}

{%- style -%}
    #shopify-section-{{ section.id }} .trust-badges__list {
        display: grid;
        grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
        gap: 30px 20px;
    }
    @media screen and (min-width: 768px) {
        #shopify-section-{{ section.id }} .trust-badges__list {
            grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
        }
    }
    #shopify-section-{{ section.id }} .trust-badges__list .product-customInformation {
        text-align: center;
        align-items: center;
    }
    #shopify-section-{{ section.id }} .trust-badges__list .product-customInformation__icon {
        margin: 0 auto 12px;
    }
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mg_top_desktop }}px;
        padding-bottom: {{ section.settings.mg_bottom_desktop }}px;
    }
{%- endstyle -%}

<div class="{% if section.settings.container == 'default' %}container{% else %}container-fluid{% endif %}">
    {%- if section.settings.heading != blank -%}
        <h2 class="trust-badges__heading text-center">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
        <div class="trust-badges__list">
            {%- for block in section.blocks -%}
                {%- if block.type == 'badge' -%}
                    {% render 'product-custom-information', block: block %}
                {%- endif -%}
            {%- endfor -%}
        </div>
    {%- endif -%}
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "section trust-badges-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why shop with us"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "default",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "fluid", "label": "Full width" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mg_top_desktop",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mg_bottom_desktop",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "liquid",
          "id": "icon",
          "label": "Icon (inline SVG)"
        },
        {
          "type": "color",
          "id": "color_icon",
          "label": "Icon color",
          "default": "#232323"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Heading"
        },
        {
          "type": "color",
          "id": "color_title",
          "label": "Heading color",
          "default": "#232323"
        },
        {
          "type": "liquid",
          "id": "text_description",
          "label": "Supporting text"
        },
        {
          "type": "color",
          "id": "color_des",
          "label": "Supporting text color",
          "default": "#999999"
        },
        {
          "type": "range",
          "id": "fontsize_text",
          "label": "Heading font size",
          "min": 8,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 16
        }
      ]
    }
